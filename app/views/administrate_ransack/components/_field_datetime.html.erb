<%= form.label(label || field, class: 'filter-label') %>
<% if AdministrateRansack.ransack?(model, {field => DateTime.now}, ransack_options) %>
  <%= form.datetime_field(field, value: form.object.send(field), step: 60) %>
<% else %>
  <%= form.datetime_field("#{field}_gteq", step: 60) %>
  <%= form.datetime_field("#{field}_lteq", step: 60) %>
<% end %>
