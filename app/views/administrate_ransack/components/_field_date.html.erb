<%= form.label(label || field, class: 'filter-label') %>
<% if AdministrateRansack.ransack?(model, {field => Time.zone.today}, ransack_options) %>
  <%= form.date_field(field, value: form.object.send(field)) %>
<% else %>
  <%= form.date_field("#{field}_gteq") %>
  <%= form.date_field("#{field}_lteq_end_of_day") %>
<% end %>
